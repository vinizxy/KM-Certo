# URL pública do site, sem barra no final (canonical, Open Graph, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Link do checkout na plataforma de infoproduto (Hotmart, Kiwify, Eduzz...). UTMs são repassadas automaticamente.
NEXT_PUBLIC_CHECKOUT_URL=

# ID do Meta Pixel. Vazio = nenhum script de rastreamento e nenhum banner de cookies.
NEXT_PUBLIC_META_PIXEL_ID=

# E-mail de contato exibido no rodapé e nas páginas legais
NEXT_PUBLIC_CONTACT_EMAIL=

# Nome da marca
NEXT_PUBLIC_BRAND_NAME=Km Certo Moto
